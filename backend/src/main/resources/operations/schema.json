{
  "slug": "mcpgateway",
  "title": "MCP扇出并发与授权有效期",
  "fields": [
    {
      "key": "id",
      "label": "记录编号",
      "type": "ID"
    },
    {
      "key": "tools",
      "label": "单请求工具数",
      "type": "NUMBER",
      "scale": 0,
      "min": "1",
      "max": "1000"
    },
    {
      "key": "parallelRequests",
      "label": "并行请求数",
      "type": "NUMBER",
      "scale": 0,
      "min": "1",
      "max": "1000"
    },
    {
      "key": "retries",
      "label": "额外重试次数",
      "type": "NUMBER",
      "scale": 0,
      "min": "0",
      "max": "20"
    },
    {
      "key": "concurrencyLimit",
      "label": "工具并发上限",
      "type": "NUMBER",
      "scale": 0,
      "min": "1",
      "max": "1000000"
    },
    {
      "key": "writes",
      "label": "包含写操作",
      "type": "ENUM",
      "options": [
        "YES",
        "NO"
      ]
    },
    {
      "key": "approved",
      "label": "写操作已批准",
      "type": "ENUM",
      "options": [
        "YES",
        "NO"
      ]
    },
    {
      "key": "approvalExpiry",
      "label": "授权有效至",
      "type": "DATE"
    }
  ],
  "columns": [
    {
      "key": "peakConcurrentCalls",
      "label": "峰值并发调用"
    },
    {
      "key": "maximumAttempts",
      "label": "最多尝试次数"
    },
    {
      "key": "expired",
      "label": "授权已过期"
    }
  ],
  "description": "核对单请求工具扇出、额外重试、并发上限和授权到期日，写工具调用要求明确批准。不发起MCP网络请求，不把调用方输入当平台授权策略。",
